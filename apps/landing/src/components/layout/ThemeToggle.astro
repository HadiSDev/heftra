---
import Icon from '../ui/Icon.astro'
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex size-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
  aria-label="Switch to dark theme"
>
  <Icon name="moon" size={18} class="[html.dark_&]:hidden" />
  <Icon name="sun" size={18} class="hidden [html.dark_&]:block" />
</button>

<script>
  import { initThemeToggles } from '../../scripts/theme'

  initThemeToggles()
</script>
