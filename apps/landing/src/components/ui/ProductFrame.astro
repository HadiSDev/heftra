---
import { Picture } from 'astro:assets'
import type { ImageOutputFormat } from 'astro'
import { screenshot } from '../../lib/screenshots'
import type { ScreenshotName } from '../../lib/screenshots'

interface Props {
  name: ScreenshotName
  alt: string
  label?: string
  eager?: boolean
  sizes?: string
  class?: string
}

const {
  name,
  alt,
  label = 'app.heftra.com',
  eager = false,
  sizes = '(min-width: 1024px) 60vw, 100vw',
  class: className,
} = Astro.props
const image = screenshot(name)
const formats: Array<ImageOutputFormat> = import.meta.env.DEV
  ? ['webp']
  : ['avif', 'webp']
---

<figure
  class:list={[
    'overflow-hidden rounded-[1.25rem] border border-white/10 bg-[#141414] shadow-product',
    className,
  ]}
>
  <div
    class="flex h-9 items-center gap-2 border-b border-white/10 px-4"
    aria-hidden="true"
  >
    <span class="size-2.5 rounded-full bg-white/20"></span>
    <span class="size-2.5 rounded-full bg-white/20"></span>
    <span class="size-2.5 rounded-full bg-white/20"></span>
    <span class="ml-3 rounded-md bg-white/5 px-3 py-0.5 font-mono text-[11px] text-white/50">
      {label}
    </span>
  </div>
  {image ? (
    <Picture
      src={image}
      alt={alt}
      formats={formats}
      fallbackFormat="webp"
      sizes={sizes}
      widths={[640, 960, 1280, 1920].filter((width) => width <= image.width)}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="block h-auto w-full"
    />
  ) : (
    <div
      role="img"
      aria-label={alt}
      data-screenshot-pending={name}
      class="grid aspect-[16/10] place-items-center bg-[radial-gradient(circle_at_50%_40%,rgb(255_255_255/0.06),transparent_60%)] font-mono text-xs tracking-[0.18em] text-white/55 uppercase"
    >
      Screenshot pending · {name}
    </div>
  )}
</figure>
