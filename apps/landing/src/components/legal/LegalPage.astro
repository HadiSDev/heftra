---
import BaseLayout from '../../layouts/BaseLayout.astro'

interface Props {
  title: string
  description: string
  lastUpdated: string
}

const { title, description, lastUpdated } = Astro.props
const formatted = new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'long',
}).format(new Date(lastUpdated))
---

<BaseLayout
  title={`${title} · Heftra`}
  description={description}
  breadcrumb={title}
>
  <article class="page-container max-w-3xl pt-40 pb-28">
    <header class="flex flex-col gap-4 border-b border-border pb-10">
      <p class="font-mono text-xs tracking-[0.18em] text-muted-foreground uppercase">
        Legal
      </p>
      <h1 class="text-display-lg font-semibold">{title}</h1>
      <p class="text-sm text-muted-foreground">
        Last updated <time datetime={lastUpdated}>{formatted}</time>
      </p>
    </header>
    <div class="legal-prose pt-10">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .legal-prose :global(h2) {
    margin-top: 2.75rem;
    margin-bottom: 0.875rem;
    font-size: 1.375rem;
    font-weight: 600;
  }

  .legal-prose :global(p),
  .legal-prose :global(li) {
    color: var(--muted-foreground);
    line-height: 1.75;
  }

  .legal-prose :global(p) {
    margin-bottom: 1rem;
  }

  .legal-prose :global(ul) {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal-prose :global(li) {
    margin-bottom: 0.375rem;
  }

  .legal-prose :global(strong) {
    color: var(--foreground);
    font-weight: 600;
  }

  .legal-prose :global(a) {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
