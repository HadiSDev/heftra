---
import { getCollection } from 'astro:content'
import PricingCard from '../ui/PricingCard.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import { links } from '../../lib/site-links'

const plans = (await getCollection('pricing')).sort(
  (a, b) => a.data.order - b.data.order,
)
const hasBothPeriods = plans.some(
  (plan) =>
    plan.data.monthlyPriceEur !== null &&
    plan.data.annualMonthlyPriceEur !== null,
)
---

<section
  id="pricing"
  class="pricing section bg-muted/50"
  aria-labelledby="pricing-title"
>
  <div class="page-container">
    <SectionHeading
      id="pricing-title"
      eyebrow="Pricing"
      title="Simple plans that pay for themselves."
      lead="Every plan starts with a free demo on your own data. Prices are in euro and exclude VAT."
      align="center"
    />
    {hasBothPeriods && (
      <fieldset class="mx-auto mt-10 flex w-fit rounded-full border border-border bg-card p-1">
        <legend class="visually-hidden">Billing period</legend>
        <label class="period-option">
          <input
            type="radio"
            name="billing-period"
            value="monthly"
            id="period-monthly"
            class="visually-hidden"
            checked
          />
          <span>Monthly</span>
        </label>
        <label class="period-option">
          <input
            type="radio"
            name="billing-period"
            value="annual"
            id="period-annual"
            class="visually-hidden"
          />
          <span>
            Yearly <span class="text-success">· 2 months free</span>
          </span>
        </label>
      </fieldset>
    )}
    <div
      class="mt-14 grid items-stretch gap-4 lg:grid-cols-3 lg:gap-5"
      data-stagger
    >
      {plans.map((plan) => (
        <PricingCard {...plan.data} ctaHref={links.demo} />
      ))}
    </div>
  </div>
</section>

<style>
  .period-option {
    position: relative;
    cursor: pointer;
  }

  .period-option > span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border-radius: 9999px;
    padding: 0.5rem 1.125rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .period-option input:checked + span {
    background-color: var(--primary);
    color: var(--primary-foreground);
  }

  .period-option input:focus-visible + span {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .pricing :global(.price-annual) {
    display: none;
  }

  .pricing:has(#period-annual:checked) :global(.price-annual) {
    display: inline;
  }

  .pricing:has(#period-annual:checked) :global(.price-monthly) {
    display: none;
  }
</style>
