---
import { getCollection } from 'astro:content'
import { assertNoDrafts } from '../../lib/drafts'

const outcomes = (await getCollection('outcomes')).sort(
  (a, b) => a.data.order - b.data.order,
)
assertNoDrafts('outcomes', outcomes, import.meta.env.PROD)
---

{outcomes.length > 0 && (
  <section
    class="border-y border-border bg-canvas py-20"
    aria-labelledby="outcomes-title"
  >
    <div class="page-container">
      <h2 id="outcomes-title" class="visually-hidden">
        Results
      </h2>
      <dl class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {outcomes.map((outcome) => (
          <div
            class="flex flex-col-reverse gap-2 border-l border-border pl-6"
            data-reveal="rise"
          >
            <dt class="text-sm text-muted-foreground">
              {outcome.data.label}
              {outcome.data.draft && (
                <span class="ml-2 rounded bg-warning px-1.5 py-0.5 text-xs font-semibold text-warning-foreground">
                  Draft
                </span>
              )}
            </dt>
            <dd class="text-display-md font-semibold tabular-nums">
              {outcome.data.prefix}
              <span data-count-to={outcome.data.value}>
                {outcome.data.value.toLocaleString('en-IE')}
              </span>
              {outcome.data.suffix}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}
