# Local vLLM (OpenAI-compatible) endpoint
VLLM_BASE_URL=http://localhost:8000/v1
# CrewAI 1.x uses native providers (no litellm); use the hosted_vllm/ prefix for vLLM
VLLM_MODEL=hosted_vllm/google/gemma-4-E4B-it
VLLM_API_KEY=not-needed
# Bound each LLM call: max_tokens caps generation (prevents runaway/hangs on
# structured output); timeout (seconds) fails a stalled request instead of blocking.
VLLM_MAX_TOKENS=8192
VLLM_TIMEOUT=120

# Embeddings for every Qdrant index (multilingual; runs in half precision on the GPU).
# Collections are named per model, so changing it builds fresh ones.
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
# Put before search texts only; the model's own query prompt. Empty for models without one.
EMBEDDING_QUERY_PREFIX="query: "
# Longer texts are cut; keeps a batch's GPU memory small beside the LLM.
EMBEDDING_MAX_TOKENS=512

# Optional path overrides (defaults shown)
# CHART_OF_ACCOUNTS_PATH=data/chart_of_accounts.csv
# INVOICES_DIR=data/invoices
# LEDGER_PATH=output/ledger.csv
# CHROMA_DIR=chroma_db

# Invoices are processed concurrently (independent units, I/O-bound work). Tune
# to what your vLLM server handles; 1 = strictly sequential (deterministic order).
INVOICE_CONCURRENCY=4

# Buyer (provided beforehand by the backend). Direct/Indirect is derived from
# the buyer's business context (scraped from the website).
BUYER_NAME=
BUYER_WEBSITE=
# Web context (buyer scrape + product search) cache + search breadth
# WEB_CONTEXT_CACHE_DIR=data/web_cache
PRODUCT_SEARCH_MAX_RESULTS=3

# Qdrant vector store (replaces ChromaDB)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# PostgreSQL (new procurement pipeline)
# DATABASE_URL=postgresql://steelyard:steelyard@localhost:5432/steelyard

# Fernet key to encrypt ERP integration credentials at rest. Required to create/
# update integration credentials. Generate one with:
#   python -c "from web_api.credentials import generate_key; print(generate_key())"
# WEB_API_CREDENTIAL_ENC_KEY=

# Web API auth (Clerk). The API verifies Clerk session JWTs against Clerk's JWKS.
# CLERK_ISSUER is your Clerk instance issuer; JWKS URL defaults to the issuer's
# well-known endpoint. CLERK_AUDIENCE is validated only when set.
# CLERK_ISSUER=https://your-slug.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-slug.clerk.accounts.dev/.well-known/jwks.json
# CLERK_AUDIENCE=
# Bypass token verification for local dev / tests (never enable in production):
# WEB_API_AUTH_DISABLED=false
# Clock-skew tolerance in seconds for iat/nbf/exp. Raise it if this host's clock
# drifts (WSL2 after sleep is a common case) and you see intermittent 401s with
# "The token is not yet valid (iat)" that succeed on retry. It widens exp too,
# so keep it small:
# CLERK_CLOCK_SKEW_SECONDS=5
# Clerk token claim that marks a platform-level system admin (truthy => is_system_admin):
# CLERK_SYSTEM_ADMIN_CLAIM=system_admin
# Browser origins allowed to call the API (comma-separated); empty = no cross-origin access:
# WEB_API_CORS_ORIGINS=http://localhost:3100
# Clerk webhooks (inbound) + Backend API (outbound org sync):
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...        # Svix signing secret from the Clerk dashboard
# CLERK_SECRET_KEY=sk_...                        # Clerk Backend API key (outbound org deletion)
# CLERK_API_BASE_URL=https://api.clerk.com/v1
# WEB_API_CLERK_OUTBOUND_DISABLED=true           # short-circuit outbound Clerk calls (dev/tests)

# Historical FX rates (ECB daily reference rates, fetched via Frankfurter and
# cached in `fx_rates`). Off by default: nothing makes an outbound rate request
# and amounts are stored unconverted until this is enabled.
#
# It also gates the document stage's currency comparison. A supplier who bills
# in EUR or USD into a DKK ledger (Anthropic, Cloudflare, EK Waterblocks all do)
# produces a document whose figures cannot be compared to the posted total
# without a rate — with this off, such an extraction is refused with a reason
# naming the mismatch rather than accepted or misreported as bad arithmetic.
# FX_ENABLED=false
# FX_PROVIDER_URL=https://api.frankfurter.dev/v1
# FX_HTTP_TIMEOUT_SECONDS=10

# Price indices for deflating spend to an emission factor's price year, read by
# `python -m web_api.price_indices.import_series --series CPIAUCSL` (FRED's public CSV, no key).
# PRICE_INDEX_CSV_URL=https://fred.stlouisfed.org/graph/fredgraph.csv
# PRICE_INDEX_HTTP_TIMEOUT_SECONDS=30

# Uploaded files (trade agreements) live in an S3-compatible bucket. Locally that is RustFS:
# `docker compose up -d rustfs` serves S3 on :9100 and its console on :9101, with the
# access and secret keys below. The bucket is created when the web API starts.
# S3_ENDPOINT_URL=http://localhost:9100
# S3_REGION=us-east-1
# S3_BUCKET=steelyard
# S3_ACCESS_KEY=steelyard
# S3_SECRET_KEY=steelyard-dev-secret
# S3_TIMEOUT_SECONDS=30

# Emission factor workbooks uploaded by a system admin wait here until their import job ends.
# UPLOAD_TMP_DIR=            # the system temp dir when unset
# EMISSION_WORKBOOK_MAX_BYTES=52428800

# -- Describing a supplier so a line can be categorized ----------------------
# "DSB" is three letters; "DSB — Danish State Railways, passenger rail operator"
# answers the question the spend taxonomy is asking. This stage researches a
# supplier once and stores the answer on the global `vendors` row, so one lookup
# serves every tenant that has ever bought from them.
#
# Off by default, like FX_ENABLED, because it reaches the public web — and
# because the catalog is shared, so what it writes is read by everyone. A
# description a person has corrected is never overwritten (`description_source`).
# VENDOR_ENRICHMENT_ENABLED=false
#
# With enrichment on, this also reads each supplier's own website instead of
# only summarizing search snippets: the site is found among the search results
# by its domain, its home page and up to MAX_PAGES pages about the company, its
# products or services are read (robots.txt honoured), and the website is
# stored on the supplier. Needs a headless browser: run `crawl4ai-setup` once.
# A site that cannot be read falls back to the snippets.
# SUPPLIER_CRAWL_ENABLED=false
# SUPPLIER_CRAWL_MAX_PAGES=3
# SUPPLIER_CRAWL_TIMEOUT_S=20
# SUPPLIER_CRAWL_MAX_CHARS=8000
#
# A company's own website, set by a manager in Settings, is researched the same
# way by the worker, so the models reading its spend and agreements know what it
# does (a smartwatch is a development device for a company building for them).
# Setting the website is the opt-in; a description a manager writes is never
# overwritten.
# COMPANY_RESEARCH_ENABLED=true
# COMPANY_RESEARCH_BATCH=2

# -- Emission sectors (python -m ai_api.emissions.runner) ---------------------
# Each line is matched to an Open CEDA sector by an agent that searches the
# sectors itself; when it fails, one question picks from the closest sectors.
# Turn the agent off to use only that single question. Import factors first:
# python -m web_api.emissions.import_factors --file <Open CEDA .xlsx> --activate
# EMISSION_AGENT_ENABLED=true
# EMISSION_AGENT_MAX_ITER=6
# EMISSION_AGENT_TIMEOUT_S=120
# EMISSION_SEARCH_RESULTS=8
# EMISSION_FALLBACK_CANDIDATES=12

# -- Trade agreements ----------------------------------------------------------
# Uploaded agreements (up to AGREEMENT_MAX_BYTES) are read by the worker one
# page at a time; pages without text are pictured, up to a cap. A read that
# fails is retried up to AGREEMENT_MAX_ATTEMPTS times.
#
# Analysis judges what was bought, not each line: lines are grouped into items
# (same thing, unit, category and supplier), and each candidate item is asked
# about once per term, AGREEMENT_JUDGE_BATCH items to a prompt with up to
# AGREEMENT_JUDGE_CONCURRENCY prompts at a time. Candidates are a term's
# categories plus items similar to its scope (above AGREEMENT_SIMILARITY_MIN),
# at most AGREEMENT_CANDIDATES_MAX, most spend first. After its first run an
# agreement is analysed incrementally: only lines changed since its last run
# (less AGREEMENT_WATERMARK_MARGIN_MINUTES), read AGREEMENT_PAGE_SIZE at a time.
# The tolerances below are allowed before an overcharge or a missed discount.
# AGREEMENT_MAX_BYTES=26214400
# AGREEMENT_HEADER_PAGES=3
# AGREEMENT_VISION_MAX_PAGES=20
# AGREEMENT_MAX_ATTEMPTS=3
# AGREEMENT_STALE_CLAIM_MINUTES=60
# AGREEMENT_SCOPE_CATEGORIES=3
# AGREEMENT_SIMILARITY_MIN=0.35
# AGREEMENT_CANDIDATES_MAX=5000
# AGREEMENT_JUDGE_BATCH=8
# AGREEMENT_JUDGE_CONCURRENCY=4
# AGREEMENT_PAGE_SIZE=2000
# AGREEMENT_WATERMARK_MARGIN_MINUTES=10
# AGREEMENT_PRICE_TOLERANCE_PCT=1.0
# AGREEMENT_DISCOUNT_TOLERANCE_PCT=0.5

# -- Cheaper alternatives ------------------------------------------------------
# Every item bought gets a specification (class, identifiers, key attributes,
# pricing unit, pack size), read ALTERNATIVES_SPEC_BATCH items to a prompt. Its
# alternatives come from the organization's own purchases, other organizations'
# anonymous prices (shown from BENCHMARK_MIN_ORGANIZATIONS, never fewer than 3)
# and marketplaces: the shops in the shop list (ALTERNATIVES_SHOPS_FILE, the
# bundled list when empty), the open web through SearXNG (SEARXNG_URL;
# DuckDuckGo when unset), and the distributor APIs whose keys are set. Pages are
# crawled with robots.txt honoured, ALTERNATIVES_HOST_INTERVAL_S apart per host,
# at most ALTERNATIVES_PAGES_PER_ITEM per item; answers are reused for
# ALTERNATIVES_OFFER_TTL_DAYS. An alternative must save at least
# ALTERNATIVES_MIN_SAVING_PERCENT. The background scan (off by default) searches
# ALTERNATIVES_SCAN_ITEMS items per company every ALTERNATIVES_SCAN_INTERVAL_HOURS,
# largest spend first, each again after ALTERNATIVES_RESCAN_DAYS; it reads the
# specifications of up to ALTERNATIVES_SCAN_SPECS items, so more of the
# company's own purchases can be compared.
SEARXNG_URL=http://localhost:8888
# ALTERNATIVES_SCAN_ENABLED=false
# ALTERNATIVES_SCAN_INTERVAL_HOURS=24
# ALTERNATIVES_SCAN_ITEMS=50
# ALTERNATIVES_SCAN_SPECS=200
# ALTERNATIVES_RESCAN_DAYS=30
# ALTERNATIVES_MIN_SAVING_PERCENT=3
# ALTERNATIVES_EQUAL_TOLERANCE_PERCENT=2
# ALTERNATIVES_SPEC_BATCH=8
# ALTERNATIVES_SPEC_CONCURRENCY=4
# ALTERNATIVES_SPEC_MAX_FAILURES=3
# ALTERNATIVES_SPEC_MIN_CONFIDENCE=0.5
# ALTERNATIVES_SIMILAR=20
# ALTERNATIVES_SIMILARITY_MIN=0.6
# ALTERNATIVES_OFFER_TTL_DAYS=14
# ALTERNATIVES_QUERIES_PER_ITEM=2
# ALTERNATIVES_PAGES_PER_ITEM=4
# ALTERNATIVES_HOST_INTERVAL_S=5
# ALTERNATIVES_PAGE_CHARS=6000
# ALTERNATIVES_PAGE_TIMEOUT_S=20
# ALTERNATIVES_SHOPS_ENABLED=true
# ALTERNATIVES_WEB_ENABLED=true
# ALTERNATIVES_SHOPS_FILE=
# SEARXNG_ENGINES=google,bing,brave,duckduckgo
# BENCHMARK_MIN_ORGANIZATIONS=3
# FARNELL_API_KEY=
# MOUSER_API_KEY=
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=

# -- When an AI categorization needs a human ---------------------------------
# The model must now return a category rather than declining, so doubt arrives
# as a low confidence instead of as a failure. Lines below this are what
# `GET /invoice-lines?needs_review=true` returns and what the line payload's
# `needs_review` flag marks. Raising it moves history immediately — the flag is
# computed on read, never stored.
# CATEGORIZATION_REVIEW_THRESHOLD=0.6

# -- Narrowing a large spend tree before the model sees it -------------------
# Embeds the line, retrieves the closest nodes from the tree's Qdrant index and
# expands each to its siblings, so the model chooses from a neighbourhood rather
# than from every leaf. A no-op below twice the top-k, and it degrades to the
# whole tree whenever retrieval finds nothing or Qdrant cannot be reached.
#
# Off by default: indexing downloads a sentence-transformer model and talks to
# Qdrant, and neither should happen in a test run or an offline sync without
# somebody asking for it.
# CATEGORY_RETRIEVAL_ENABLED=false
# CATEGORY_RETRIEVAL_TOP_K=5

# -- Reading documents that have no text layer -------------------------------
# A photo, a screenshot or a scan is rendered and shown to the model. Both
# bounds keep one document affordable: each page is an image worth thousands of
# tokens, and a phone photo carries no detail at 4000px that a receipt needs.
# DOC_VISION_MAX_PAGES=8
# DOC_VISION_MAX_EDGE=1600

# -- Do the extracted lines add up? ------------------------------------------
# Two checks, two tolerances, because there are two questions.
#
# The first pair sizes a comparison between the document and the LEDGER, where a
# supplier printing VAT-inclusive and a bookkeeper posting VAT-exclusive are
# both correct. It is used when the document states no total of its own, and to
# decide whether the two totals `totals_agree`.
# DOC_RECONCILE_TOLERANCE_PCT=0.01
# DOC_RECONCILE_TOLERANCE_ABS=1.00
#
# The second sizes arithmetic WITHIN one document — its lines against the total
# printed on the same page — which ought to be near-exact, so it is much
# tighter. This is the check that rejects an extraction: failing it means we
# misread the page. The absolute floor exists only because per-line rounding can
# drift a cent per line on a long invoice.
# DOC_INTERNAL_TOLERANCE_PCT=0.001
# DOC_INTERNAL_TOLERANCE_ABS=0.10

# Sampling temperature for every `get_llm()` call — extraction, categorization,
# supplier lookup. Zero by default: these read, they do not compose, and an
# invoice that processes on one run and fails on the next cannot be debugged.
# The synthetic-data generator builds its own LLM and is unaffected.
# VLLM_TEMPERATURE=0.0

# -- Billy fixtures (development only) ---------------------------------------
# A Billy access token for `apps/web-api/scripts/billy_fixtures.py`, which re-captures the
# scrubbed API responses the connector tests run against. Read-only, opt-in, and
# never part of `uv run pytest`.
#
# This is NOT how the connector authenticates at runtime: a customer enters
# their own Billy token in Settings, and it is stored encrypted on their
# `ErpCredential` row (see WEB_API_CREDENTIAL_ENC_KEY above). Nothing in
# `apps/*/src/` reads this variable.
# BILLY_ACCESS_TOKEN=

# -- Pipeline worker (`python -m ai_api.worker`) -----------------------------
# Seconds the worker waits between polls that found nothing to do, and the most
# pending documents it reads in one pass before checking for requested runs
# again.
# WORKER_POLL_SECONDS=5
# WORKER_DOCUMENT_BATCH=5
